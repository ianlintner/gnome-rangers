class_name RootfallHollow
extends Node3D
## Root script of the Rootfall Hollow level (approach path, fog gate, boss arena).
##
## The scene itself is generated by `tools/level/build_rootfall.gd` from [RootfallLayout]; this
## script only wires the level into the game: it publishes the player's spawn, and applies the
## documented render-quality overrides to a private copy of the shared `forest_day` environment.
## The ambient loop is a plain autoplaying player: looping is configured on the WAV import.

## Render-quality tiers. HIGH is the full art-direction look; DEV is the documented iGPU tier
## (see docs/art-direction.md, "Rootfall Hollow overrides").
enum QualityTier { HIGH, DEV }

## HIGH-tier `volumetric_fog_length` override (metres), per docs/art-direction.md.
const HIGH_FOG_LENGTH: float = 80.0

## The tier applied to this level's environment copy.
@export var quality_tier: QualityTier = QualityTier.HIGH

var _baseline_environment: Environment = null
var _baseline_shadow_distance: float = 0.0
var _baseline_fog_volume: Vector2i = Vector2i(64, 64)
var _baseline_shadow_atlas: int = 4096
var _baseline_msaa: Viewport.MSAA = Viewport.MSAA_DISABLED

@onready var _world_environment: WorldEnvironment = $WorldEnvironment
@onready var _player_start: Marker3D = $PlayerStart
@onready var _sun: DirectionalLight3D = $Sun


func _ready() -> void:
	GameState.spawn_transform = _player_start.global_transform
	# Snapshot everything a tier may touch, including renderer-wide settings, so any tier can
	# be restored exactly (HIGH -> DEV -> HIGH) and the overrides never outlive the level.
	_baseline_environment = _world_environment.environment.duplicate() as Environment
	_baseline_shadow_distance = _sun.directional_shadow_max_distance
	_baseline_fog_volume = Vector2i(
		ProjectSettings.get_setting("rendering/environment/volumetric_fog/volume_size", 64),
		ProjectSettings.get_setting("rendering/environment/volumetric_fog/volume_depth", 64)
	)
	_baseline_shadow_atlas = ProjectSettings.get_setting(
		"rendering/lights_and_shadows/directional_shadow/size", 4096
	)
	var viewport: Viewport = get_viewport()
	if viewport != null:
		_baseline_msaa = viewport.msaa_3d
	apply_quality_tier(quality_tier)


func _exit_tree() -> void:
	# Renderer-wide overrides must not outlive the level.
	if _baseline_environment != null:
		_restore_renderer_baseline()


## Overrides tunables on a *copy* of the shared environment; the `.tres` is never mutated.
## Always starts from the baseline snapshot, so switching tiers is order independent.
func apply_quality_tier(tier: QualityTier) -> void:
	quality_tier = tier
	var environment: Environment = _baseline_environment.duplicate() as Environment
	_world_environment.environment = environment
	_restore_renderer_baseline()
	if tier != QualityTier.DEV:
		# Documented HIGH override (docs/art-direction.md): deeper fog for god rays.
		environment.volumetric_fog_length = HIGH_FOG_LENGTH
		return
	# iGPU tier: cascaded GI and screen-space GI are the heaviest passes.
	environment.sdfgi_enabled = false
	environment.ssil_enabled = false
	environment.ssao_enabled = false
	environment.volumetric_fog_length = 48.0
	environment.volumetric_fog_detail_spread = 1.5
	_sun.directional_shadow_max_distance = 70.0
	RenderingServer.environment_set_volumetric_fog_volume_size(48, 48)
	RenderingServer.directional_shadow_atlas_set_size(2048, true)
	var viewport: Viewport = get_viewport()
	if viewport != null:
		viewport.msaa_3d = Viewport.MSAA_DISABLED


func _restore_renderer_baseline() -> void:
	_sun.directional_shadow_max_distance = _baseline_shadow_distance
	RenderingServer.environment_set_volumetric_fog_volume_size(
		_baseline_fog_volume.x, _baseline_fog_volume.y
	)
	RenderingServer.directional_shadow_atlas_set_size(_baseline_shadow_atlas, true)
	var viewport: Viewport = get_viewport()
	if viewport != null:
		viewport.msaa_3d = _baseline_msaa
